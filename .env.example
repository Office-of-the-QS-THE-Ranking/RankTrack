# Supabase project (Project Settings › API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://isbtudqjazqnbugachqa.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: reads and writes the governance store. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# The first Administrator of the Rankings Office (University-wide), created at their first sign-in. Remove it from
# production once others run the Hub: whoever holds this mailbox can restore an Administrator.
HUB_BOOTSTRAP_ADMIN=

# Google OAuth client (Google Cloud › APIs & Services › Credentials). Read by
# `supabase config push` to enable Google sign-in in Supabase Auth; the app never reads them.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Cloudflare R2 holds files (Cloudflare › R2 › Manage API tokens: Object Read & Write on both buckets).
# Server only. Uploads and internal portal files go to the private bucket; what the public website shows is
# copied to the public one. The private bucket needs a CORS rule for browser uploads: scripts/r2/cors.mjs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=private-ranktrack
R2_PUBLIC_BUCKET=public-ranktrack
# Where public-ranktrack is served: its r2.dev address or a custom domain (R2 › bucket › Settings › Public access).
R2_PUBLIC_URL=

# The Hub's public address, with no path. Google sign-in returns here (/auth/callback), so a forged Host header
# can never choose where an authorization code is sent. On Vercel it may stay empty until there is a custom
# domain: the project's production address (VERCEL_PROJECT_PRODUCTION_URL) is used. Either way, add
# <address>/auth/callback to Supabase Auth's redirect allow list (exact, no wildcards).
HUB_SITE_URL=

# The request header your proxy sets, and overwrites, with the client's address: rate limits tell clients apart
# by it. Leave empty on Vercel (its x-real-ip is used); cf-connecting-ip behind Cloudflare.
HUB_CLIENT_IP_HEADER=

# Optional: a Slack, Google Chat or Discord incoming webhook for operational alerts (failed saves, recovery
# points, public media sync, audit anchoring, server errors). Without it, alerts are JSON lines in the log.
HUB_ALERT_WEBHOOK=
