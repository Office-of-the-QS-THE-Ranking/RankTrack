{
  "name": "ust-rankings-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ocr-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts.tmp && mv src/lib/supabase/database.types.ts.tmp src/lib/supabase/database.types.ts || (rm -f src/lib/supabase/database.types.ts.tmp; exit 1)",
    "test": "vitest run",
    "test:assistant-live": "vitest run --config vitest.live.config.ts",
    "db:lint": "npx supabase db lint --linked --level warning"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fil": "^1.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.165",
    "aws4fetch": "^1.0.20",
    "gsap": "^3.13.0",
    "motion": "^14.5.0",
    "next": "16.4.1",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.4"
  }
}
